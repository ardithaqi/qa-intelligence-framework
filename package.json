{
  "name": "qa-framework",
  "version": "1.5.0",
  "description": "Playwright template with qa-intelligence CI engine via npm",
  "main": "index.js",
  "scripts": {
    "test:examples": "playwright test tests/examples/saucedemo",
    "test:smoke": "playwright test tests/smoke",
    "test:regression": "playwright test tests/regression",
    "test:all": "playwright test",
    "ci:diff:local": "npx qa-intelligence-diff --baseline baseline-artifacts --current artifacts --fail-on-blocking false",
    "report": "playwright show-report",
    "docker:build": "docker build -t qa-framework .",
    "docker:test": "docker run --rm qa-framework"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "qa-intelligence": "^1.5.2"
  },
  "engines": {
    "node": ">=18"
  }
}
